#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = [
#     "loguru>=0.7",
# ]
# ///
"""Unified deploy tool for the nornir workspace.

Builds, symlinks, and verifies nornir binaries by category.
Reads crate-to-category mapping from deploy_categories.toml.

Any category can declare:
  crates       — cargo binaries (build + symlink + verify)
  cli_crates   — cargo binaries with separate cli_verify (e.g. gates check tools)
  pyo3_crates  — maturin PyO3 modules (build + python_import verify)
  gate_crates  — same as pyo3_crates, used by the gates category

Usage:
    nornir_deploy --all                  # deploy everything
    nornir_deploy --non-pyo3             # all cargo crates, skip maturin PyO3 modules
    nornir_deploy --build gates          # single category
    nornir_deploy --build hooks,writers  # multiple categories
    nornir_deploy --list                 # show categories and crate counts
    nornir_deploy --bootstrap            # create symlink in ~/.ai/tools/scripts/
"""

import argparse
import subprocess
import sys
import zipfile
from pathlib import Path

from loguru import logger

NORNIR_DIR = Path(__file__).resolve().parent
CATEGORIES_FILE = NORNIR_DIR / "deploy_categories.toml"
TOOLS_BIN = Path.home() / ".ai" / "tools" / "bin"
TOOLS_SCRIPTS = Path.home() / ".ai" / "tools" / "scripts"
TOOLS_LIB = Path.home() / ".ai" / "tools" / "lib"


# --- TOML loading (stdlib, Python 3.11+) ---

def load_categories() -> dict:
    """Load deploy_categories.toml and return parsed dict."""
    import tomllib
    with open(CATEGORIES_FILE, "rb") as fh:
        return tomllib.load(fh)


def find_crate_dirs() -> dict[str, Path]:
    """Map crate name -> crate directory from workspace Cargo.toml members.

    Relies on the workspace convention: every member path ends with the crate
    name as the final directory segment (e.g. interceptors/traffic_interceptor_rewriter).
    """
    import tomllib
    with open(NORNIR_DIR / "Cargo.toml", "rb") as fh:
        workspace = tomllib.load(fh)
    result = {}
    for member in workspace.get("workspace", {}).get("members", []):
        crate_name = Path(member).name
        result[crate_name] = NORNIR_DIR / member
    return result


# --- Category config helpers ---

def _pyo3_crates(config: dict) -> list[str]:
    """Return maturin-built crates: pyo3_crates (generic) or gate_crates (gates)."""
    return config.get("pyo3_crates", config.get("gate_crates", []))


def _pyo3_verify(config: dict) -> str:
    return config.get("pyo3_verify", config.get("gate_verify", "python_import"))


# --- Build functions ---

def build_cargo(crates: list[str]) -> None:
    """Build crates with cargo --release. Exits on failure."""
    if not crates:
        return
    packages = []
    for crate in crates:
        packages.extend(["-p", crate])
    logger.info("cargo build --release: {} crates", len(crates))
    result = subprocess.run(
        ["cargo", "build", "--release", *packages],
        cwd=NORNIR_DIR,
    )
    if result.returncode != 0:
        logger.error("cargo build failed")
        sys.exit(1)


def build_maturin(crates: list[str], python_version: str, crate_dirs: dict[str, Path]) -> None:
    """Build PyO3 crates with maturin. Extract .so to TOOLS_LIB."""
    if not crates:
        return
    TOOLS_LIB.mkdir(parents=True, exist_ok=True)
    wheels_dir = NORNIR_DIR / "target" / "wheels"

    for crate in crates:
        crate_dir = crate_dirs.get(crate)
        if crate_dir is None:
            logger.error("crate directory not found for: {}", crate)
            sys.exit(1)
        logger.info("  maturin: {}...", crate)
        result = subprocess.run(
            ["uvx", "maturin", "build", "--release", "-i", python_version],
            cwd=crate_dir,
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            logger.error("maturin build {} failed", crate)
            logger.error("{}", result.stderr)
            sys.exit(1)

        wheels = sorted(wheels_dir.glob(f"{crate}-*.whl"))
        if not wheels:
            logger.error("no wheel found for {}", crate)
            sys.exit(1)

        wheel = wheels[-1]
        with zipfile.ZipFile(wheel) as zf:
            so_files = [name for name in zf.namelist() if name.endswith(".so")]
            if not so_files:
                logger.error("no .so in wheel {}", wheel.name)
                sys.exit(1)
            for so_file in so_files:
                so_name = Path(so_file).name
                dest = TOOLS_LIB / so_name
                with zf.open(so_file) as src, open(dest, "wb") as dst:
                    dst.write(src.read())
                dest.chmod(0o755)
                subprocess.run(["codesign", "-f", "-s", "-", str(dest)], capture_output=True)

    logger.info("PyO3 modules deployed to {}", TOOLS_LIB)


# --- Symlink ---

def symlink_binaries(crates: list[str], binary_names: dict[str, str]) -> int:
    """Create/update symlinks in TOOLS_BIN. Returns count of links created."""
    TOOLS_BIN.mkdir(parents=True, exist_ok=True)
    release_dir = NORNIR_DIR / "target" / "release"
    linked = 0

    for crate in crates:
        bin_name = binary_names.get(crate, crate)
        binary = release_dir / bin_name
        if not binary.exists():
            logger.warning("binary not found: {}", binary)
            continue

        link = TOOLS_BIN / bin_name
        if link.is_symlink() or link.exists():
            link.unlink()
        link.symlink_to(binary)
        linked += 1

    return linked


# --- Verify ---

def verify_help(binary: Path) -> bool:
    """Verify binary responds to --help (exit 0 or 1)."""
    result = subprocess.run([str(binary), "--help"], capture_output=True)
    return result.returncode in (0, 1)


def verify_stdin(binary: Path, verify_input: str) -> bool:
    """Verify binary accepts JSON on stdin (exit 0)."""
    result = subprocess.run(
        [str(binary)],
        input=verify_input.encode(),
        capture_output=True,
    )
    return result.returncode == 0


def verify_exit_codes(binary: Path, valid_codes: list[int]) -> bool:
    """Verify binary exits with an accepted code when run with no args."""
    result = subprocess.run([str(binary)], capture_output=True)
    return result.returncode in valid_codes


def verify_python_import(crate: str, python_version: str) -> bool:
    """Verify PyO3 module can be imported."""
    result = subprocess.run(
        [
            python_version, "-c",
            f"import sys; sys.path.insert(0, '{TOOLS_LIB}'); import {crate}",
        ],
        capture_output=True,
        text=True,
    )
    return result.returncode == 0


def verify_crate(crate: str, binary: Path, method: str, category_config: dict) -> bool:
    """Dispatch to correct verify strategy. Returns True on success."""
    if method == "help":
        return verify_help(binary)
    if method == "stdin":
        return verify_stdin(binary, category_config.get("verify_input", "{}"))
    if method == "exit_codes":
        valid = category_config.get("valid_exit_codes", [0])
        return verify_exit_codes(binary, valid)
    if method == "python_import":
        python_version = category_config.get("python_version", "python3.13")
        return verify_python_import(crate, python_version)
    logger.error("unknown verify method: {}", method)
    return False


# --- Category deployment ---

def deploy_category(name: str, config: dict, crate_dirs: dict[str, Path], skip_maturin: bool = False) -> None:
    """Deploy a single category: build -> symlink -> verify.

    Handles three crate types in any combination:
      crates      — cargo binaries
      cli_crates  — cargo binaries with cli_verify
      pyo3_crates / gate_crates — maturin PyO3 modules
    """
    logger.info("--- deploying: {} ---", name)
    binary_names = config.get("binary_names", {})

    # Cargo binaries
    crates = config.get("crates", [])
    if crates:
        build_cargo(crates)
        linked = symlink_binaries(crates, binary_names)
        logger.info("{} symlinks updated in {}", linked, TOOLS_BIN)
        method = config.get("verify", "help")
        release_dir = NORNIR_DIR / "target" / "release"
        failures = []
        for crate in crates:
            bin_name = binary_names.get(crate, crate)
            if verify_crate(crate, release_dir / bin_name, method, config):
                logger.info("  {}: {}", name, bin_name)
            else:
                failures.append(bin_name)
        if failures:
            logger.error("{} {} broken: {}", len(failures), name, ", ".join(failures))
            sys.exit(1)

    # Cargo CLI tools (separate verify method)
    cli_crates = config.get("cli_crates", [])
    if cli_crates:
        build_cargo(cli_crates)
        linked = symlink_binaries(cli_crates, {})
        logger.info("{} CLI symlinks updated in {}", linked, TOOLS_BIN)
        cli_method = config.get("cli_verify", "help")
        release_dir = NORNIR_DIR / "target" / "release"
        failures = []
        for crate in cli_crates:
            if verify_crate(crate, release_dir / crate, cli_method, config):
                logger.info("  CLI: {}", crate)
            else:
                failures.append(crate)
        if failures:
            logger.error("{} CLI tools broken: {}", len(failures), ", ".join(failures))
            sys.exit(1)

    # PyO3 modules (maturin)
    pyo3 = _pyo3_crates(config)
    if pyo3 and not skip_maturin:
        python_version = config.get("python_version", "python3.13")
        build_maturin(pyo3, python_version, crate_dirs)
        failures = []
        for crate in pyo3:
            if verify_python_import(crate, python_version):
                logger.info("  pyo3: {}", crate)
            else:
                failures.append(crate)
        if failures:
            logger.error("{} PyO3 modules broken: {}", len(failures), ", ".join(failures))
            sys.exit(1)
    elif pyo3 and skip_maturin:
        logger.info("{}: {} PyO3 modules skipped (--non-pyo3)", name, len(pyo3))

    total = len(crates) + len(cli_crates) + len(pyo3)
    if total == 0:
        logger.warning("no crates in category {}", name)
    else:
        logger.info("{}: done ({} cargo, {} CLI, {} PyO3)", name, len(crates), len(cli_crates), len(pyo3))


# --- Bootstrap ---

def bootstrap() -> None:
    """Create/update symlink for nornir_deploy itself in TOOLS_SCRIPTS."""
    TOOLS_SCRIPTS.mkdir(parents=True, exist_ok=True)
    script = Path(__file__).resolve()
    link = TOOLS_SCRIPTS / "nornir_deploy"
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(script)
    logger.info("nornir_deploy symlinked: {} -> {}", link, script)
    # Clean up stale symlink in tools/bin/ if it exists
    stale = TOOLS_BIN / "nornir_deploy"
    if stale.is_symlink() or stale.exists():
        stale.unlink()
        logger.info("removed stale symlink: {}", stale)


def ensure_bootstrap() -> None:
    """Auto-bootstrap if symlink doesn't exist yet."""
    link = TOOLS_SCRIPTS / "nornir_deploy"
    if not link.exists():
        logger.info("first run — bootstrapping nornir_deploy into PATH")
        bootstrap()


# --- CLI ---

def list_categories(categories: dict) -> None:
    """Print categories and their crate counts."""
    for name, config in sorted(categories.items()):
        cargo = len(config.get("crates", []))
        cli = len(config.get("cli_crates", []))
        pyo3 = len(_pyo3_crates(config))
        parts = []
        if cargo:
            parts.append(f"{cargo} cargo")
        if cli:
            parts.append(f"{cli} CLI")
        if pyo3:
            parts.append(f"{pyo3} PyO3")
        summary = " + ".join(parts) if parts else "0"
        print(f"  {name}: {summary}")


def parse_args() -> argparse.Namespace:
    """Parse CLI arguments."""
    parser = argparse.ArgumentParser(
        prog="nornir_deploy",
        description="Unified deploy tool for the nornir workspace.",
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--all", action="store_true", help="deploy all categories")
    group.add_argument("--non-pyo3", action="store_true", help="deploy all cargo crates, skip maturin PyO3 modules")
    group.add_argument("--build", type=str, help="deploy specific categories (comma-separated)")
    group.add_argument("--list", action="store_true", help="list categories and crate counts")
    group.add_argument("--bootstrap", action="store_true", help="create symlink in ~/.ai/tools/scripts/")
    return parser.parse_args()


def run(args: argparse.Namespace) -> None:
    """Execute deployment based on parsed arguments."""
    if args.bootstrap:
        bootstrap()
        return

    categories = load_categories()

    if args.list:
        list_categories(categories)
        return

    ensure_bootstrap()
    crate_dirs = find_crate_dirs()

    if args.all:
        for name, config in categories.items():
            deploy_category(name, config, crate_dirs, skip_maturin=False)
    elif args.non_pyo3:
        for name, config in categories.items():
            deploy_category(name, config, crate_dirs, skip_maturin=True)
    elif args.build:
        requested = [c.strip() for c in args.build.split(",")]
        for name in requested:
            if name not in categories:
                logger.error("unknown category: {} (available: {})", name, ", ".join(categories))
                sys.exit(1)
            deploy_category(name, categories[name], crate_dirs, skip_maturin=False)

    logger.info("DEPLOY COMPLETE")


if __name__ == "__main__":
    run(parse_args())
